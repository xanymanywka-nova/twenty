TAG=latest
SERVER_URL=https://crm.nova-tool.online

PG_DATABASE_NAME=nova_crm
PG_DATABASE_USER=nova_crm
PG_DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
FALLBACK_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
APP_SECRET=CHANGE_ME_APPLICATION_SECRET

DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
STORAGE_TYPE=local

# Disable upstream services and outbound diagnostics in production.
TELEMETRY_ENABLED=false
EXCEPTION_HANDLER_DRIVER=CONSOLE
SUPPORT_DRIVER=NONE
CHECK_FOR_UPDATES_ENABLED=false
IS_BILLING_ENABLED=false

EMAIL_FROM_ADDRESS=noreply@crm.nova-tool.online
EMAIL_FROM_NAME=Nova CRM
