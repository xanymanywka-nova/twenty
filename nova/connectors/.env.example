NOVA_CRM_URL=http://server:3000
NOVA_CRM_API_KEY=replace-with-workspace-api-key
APALEO_CLIENT_ID=replace-with-client-id
APALEO_CLIENT_SECRET=replace-with-client-secret
WELCOME_SUPABASE_URL=https://replace.supabase.co
WELCOME_SUPABASE_KEY=replace-with-read-only-key
LEGACY_CRM_DATABASE_URL=postgresql://readonly:replace@127.0.0.1:55432/nova_crm
HOTEL_ANNA_DATABASE_PATH=/data/hotel-anna/prod.db
REVIEW_MONITOR_DATABASE_PATH=/data/review-monitor/reviews.db
NOVA_BEDS_DATABASE_PATH=/data/nova-beds/prod.db
STRIPE_READ_KEY=rk_live_replace
CONNECTOR_APALEO_ENABLED=true
CONNECTOR_APALEO_CRON=*/15 * * * *
CONNECTOR_WELCOME_ENABLED=true
CONNECTOR_WELCOME_CRON=*/15 * * * *
CONNECTOR_HOTEL_ANNA_ENABLED=true
CONNECTOR_HOTEL_ANNA_CRON=5 * * * *
CONNECTOR_REVIEW_MONITOR_ENABLED=true
CONNECTOR_REVIEW_MONITOR_CRON=10 * * * *
CONNECTOR_STRIPE_ENABLED=false
CONNECTOR_STRIPE_CRON=20 * * * *
CONNECTOR_NOVA_BEDS_ENABLED=true
